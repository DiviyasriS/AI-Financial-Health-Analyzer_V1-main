{
  "ApplicationName": "AI Financial Health Analyzer API",

  "Serilog": {
  "Using": [
    "Serilog.Sinks.Console",
    "Serilog.Sinks.File",
    "Serilog.Enrichers.Environment",
    "Serilog.Enrichers.Thread"
  ],
  "MinimumLevel": {
    "Default": "Information",
    "Override": {
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System": "Warning"
    }
  },
  "Enrich": [
    "FromLogContext",
    "WithMachineName",
    "WithThreadId"
  ],
  "WriteTo": [
    {
      "Name": "Console"
    },
    {
  "Name": "File",
  "Args": {
    "path": "Logs/application-log.txt",
    "rollingInterval": "Infinite",
    "shared": true,
    "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss}] [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
  }
}
  ],
  "Properties": {
    "Application": "AI Financial Health Analyzer API"
  }
},

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Jwt": {
    "Key": "",
    "Issuer": "AIFinancialAnalyzer",
    "Audience": "AIFinancialAnalyzerUsers",
    "ExpiryDays": 7
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },

  "Authentication": {
    "Google": {
      "ClientId": "511576640967-sk0m9tfcb2cgrm7clgsccs0kmr00mc7r.apps.googleusercontent.com"
    }
  },

  "Otp": {
    "ExpiryMinutes": 5,
    "MaxAttempts": 5
  },
  "Smtp": {
  "Host": "smtp.gmail.com",
  "Port": 587,
  "EnableSsl": true,
  "FromEmail": "your-email@gmail.com",
  "FromName": "AI Financial Health Analyzer",
  "Username": "",
  "Password": ""
}
  
}